# RetryWise server configuration template.
#
# This file contains placeholders only. Copy it to .env for local development;
# never commit the copied file. Live credentials must come from a deployment
# secret manager and must never be stored in a local dotenv file.

# Runtime identity. Allowed effect modes: disabled, razorpay_test.
# There is deliberately no local live-mode example.
RETRYWISE_ENVIRONMENT=development
RETRYWISE_DATA_SOURCE=REPLAY
RETRYWISE_EFFECTS_MODE=disabled
RETRYWISE_GLOBAL_KILL_SWITCH=true
RETRYWISE_CODE_REVISION=local-development

# Server-only HTTP configuration. Do not create NEXT_PUBLIC_ equivalents for
# any secret or provider setting.
RETRYWISE_API_BIND_HOST=127.0.0.1
RETRYWISE_API_PORT=8000
RETRYWISE_PUBLIC_BASE_URL=http://127.0.0.1:8000
RETRYWISE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
RETRYWISE_LOG_LEVEL=INFO
RETRYWISE_WEBHOOK_MAX_BODY_BYTES=262144
RETRYWISE_WEBHOOK_ENDPOINT_TOKEN=
RETRYWISE_SESSION_SIGNING_SECRET=
RETRYWISE_MERCHANT_ID=
RETRYWISE_PROVIDER_ACCOUNT_ID=
RETRYWISE_OPERATOR_TOKEN=
RETRYWISE_OPERATOR_SUBJECT=local-operator
RETRYWISE_WORKER_ID=
RETRYWISE_SECRET_ROOT=/run/secrets/retrywise

# Local development database only. Use a separate database, role, and network
# boundary for every deployed environment. Sandbox/production require
# DATABASE_REQUIRE_TLS=true; the built-in connector then forces verify-full over
# a single-host TCP PostgreSQL URI and needs a trusted server CA/certificate.
DATABASE_URL=
DATABASE_REQUIRE_TLS=false

# Provider account/webhook metadata only. Outbound API credentials are enrolled
# through the versioned managed-secret binding; raw RAZORPAY_KEY_ID/SECRET
# environment variables are rejected. Keep effects disabled for replay work.
RAZORPAY_ACCOUNT_ID=
# Preferred: an absolute owner-only (0600) JSON secret file containing
# {"current":"..."}; optional rotation fields are previous/previous_expires_at.
RAZORPAY_WEBHOOK_SECRET_FILE=
RAZORPAY_WEBHOOK_SECRET_CURRENT=
# Configure both rotation fields or neither. Expiry format: YYYY-MM-DDTHH:MM:SSZ.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS_EXPIRES_AT=

# Optional external diagnosis. The operator selects Local ML, Hybrid Gemini,
# or Shadow comparison in the console; deterministic policy always authorizes
# effects. The JSON file must be absolute, owner-only (0600), and contain only
# {"api_key":"..."}. If it is absent or Gemini fails, local ML remains available.
RETRYWISE_GEMINI_API_KEY_FILE=
RETRYWISE_GEMINI_MODEL=gemini-2.5-flash
RETRYWISE_GEMINI_TIMEOUT_SECONDS=2.5
